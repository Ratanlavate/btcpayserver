<div id="PosOptions" class="modal fade" ref="OptionsModal" tabindex="-1" v-cloak>
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" v-if="optionsItem">
        <div class="modal-content">
            <header class="modal-header">
                <h5 class="modal-title" v-text="optionsItem.title"></h5>
                <button type="button" class="btn-close" v-on:click="closeOptions" aria-label="@StringLocalizer["Close"]"></button>
            </header>
            <div class="modal-body d-flex flex-column gap-4">
                <div v-for="(group, groupIndex) in optionsItem.groups" class="d-flex flex-column gap-2">
                    <h6 class="mb-0" v-text="group.title"></h6>
                    <div class="btcpay-pills d-flex flex-wrap align-items-center gap-2">
                        <template v-for="(choice, choiceIndex) in group.choices">
                            <input :id="`Option-${optionsItem.id}-${groupIndex}-${choiceIndex}`"
                                   class="btcpay-pill__checkbox"
                                   type="checkbox" name="options"
                                   v-model="choice.selected">
                            <label :for="`Option-${optionsItem.id}-${groupIndex}-${choiceIndex}`"
                                   class="btcpay-pill__label btcpay-pill px-3">
                                {{ choice.title }}<template v-if="choice.price > 0"> <span class="badge text-bg-info ms-2">+{{ formatCurrency(choice.price, false) }}</span></template>
                            </label>
                        </template>
                    </div>
                </div>
            </div>
            <footer class="modal-footer p-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold">{{ formatCurrency(+(optionsItem.price||0) + optionsTotalDelta(optionsItem), true) }}</span>
                    <button id="OptionsConfirm" type="button" class="btn btn-primary me-2" :disabled="!hasSelectedOptions(optionsItem)" v-on:click="confirmOptions" text-translate="true">
                        Add to order
                    </button>
                </div>
            </footer>
        </div>
    </div>
</div>
